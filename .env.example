# AegisML Environment Configuration
# Copy this file to .env and fill in your values

# === Database ===
DATABASE_URL=postgresql://aegisml:aegisml_secret@localhost:5432/aegisml
POSTGRES_USER=aegisml
POSTGRES_PASSWORD=aegisml_secret
POSTGRES_DB=aegisml

# === MLflow ===
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=aegisml-churn
MLFLOW_MODEL_NAME=churn-classifier

# === AegisML Backend ===
AEGISML_API_KEY=dev-api-key-change-in-production
AEGISML_SECRET_KEY=change-this-secret-key-in-production
AEGISML_ENVIRONMENT=development
LOG_LEVEL=INFO

# === LLM Provider ===
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODE=rule_based   # rule_based | disabled

# === Monitoring ===
MONITORING_INTERVAL_SECONDS=60
DRIFT_CHECK_INTERVAL_SECONDS=300
PERFORMANCE_CHECK_INTERVAL_SECONDS=120

# === ML Thresholds (Policy Configuration) ===
DRIFT_THRESHOLD=0.20
F1_THRESHOLD=0.82
LATENCY_SLA_MS=200
ERROR_RATE_THRESHOLD=0.05
CONSECUTIVE_WINDOWS_FOR_INCIDENT=3

# === Deployment ===
CANARY_INITIAL_TRAFFIC=0.10
CANARY_STEP_SIZE=0.15
CANARY_HEALTH_CHECK_INTERVAL=30
AUTO_PROMOTE_THRESHOLD=0.95

# === Prometheus ===
PROMETHEUS_PORT=9090

# === Grafana ===
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# === Frontend ===
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
